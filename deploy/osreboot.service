# OSreboot on the VPS behind nginx: code in /opt/osreboot, Node in /opt/node,
# token digests in /etc/osreboot/devices.json, files in /srv/osreboot/files.
[Unit]
Description=OSreboot status and image server
After=network.target

[Service]
ExecStart=/opt/node/bin/node /opt/osreboot/dist/server.js
WorkingDirectory=/opt/osreboot
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8090 HEARTBEAT_TIMEOUT_MS=3000
Environment=DATA_DIR=/var/lib/osreboot FILES_DIR=/srv/osreboot/files
Environment=DEVICES_FILE=/run/credentials/osreboot.service/devices.json
LoadCredential=devices.json:/etc/osreboot/devices.json
DynamicUser=yes
StateDirectory=osreboot
Restart=on-failure
RestartSec=2

# The VPS also runs the VPN: keep the server small.
MemoryMax=256M
TasksMax=64

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
