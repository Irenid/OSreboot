# The restored test system has started: the network boot osreboot-wipe turned
# on is no longer needed. Until then a power cut only restarts the recovery.
[Unit]
Description=OSreboot: end the network boot
# Only in the test system: the recovery environment has these files too.
ConditionKernelCommandLine=root=PARTLABEL=osreboot-root

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/osreboot-netboot-off

[Install]
WantedBy=multi-user.target
