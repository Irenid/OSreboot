# The system has no public address: it connects out, and a socket on the server leads back to sshd.
[Unit]
Description=OSreboot reverse SSH tunnel
Wants=network-online.target
# Only an order: Wants= would wait 90 s where there is no TPM.
After=network-online.target tpm2.target
# Keeps trying while the network is down.
StartLimitIntervalSec=0

[Service]
Environment=OSREBOOT_TUNNEL=osreboot-tunnel@example.org OSREBOOT_TUNNEL_SOCKET=/var/lib/osreboot-tunnel/sock/ssh.sock
# A virtual machine without the TPM can pass the key in.
ImportCredential=osreboot-tunnel-key
# A dead connection ends within 45 s (3 × 15 s); Restart= opens a new one.
ExecStart=/usr/bin/ssh -NT -i %d/osreboot-tunnel-key \
	-o IdentitiesOnly=yes -o BatchMode=yes \
	-o StrictHostKeyChecking=yes -o UserKnownHostsFile=none \
	-o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
	-o ExitOnForwardFailure=yes \
	-R ${OSREBOOT_TUNNEL_SOCKET}:127.0.0.1:22 ${OSREBOOT_TUNNEL}
Restart=always
RestartSec=10
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
