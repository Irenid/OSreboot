#!/bin/sh
# Installs the OSreboot client, which ExtraTrees copies in from ../client.
set -eu

ln -sf ../lib/osreboot-client/osreboot-client "$BUILDROOT/usr/local/bin/osreboot-client"
install -m 0644 "$BUILDROOT/usr/local/lib/osreboot-client/osreboot-heartbeat.service" \
	"$BUILDROOT/etc/systemd/system/osreboot-heartbeat.service"
