#!/bin/sh
# Sends heartbeats and stage reports to the OSreboot server at $OSREBOOT_URL.
#   osreboot-client heartbeat                      one a second, until stopped
#   osreboot-client stage NAME [PERCENT|-] [TEXT]  e.g. stage download 42
set -eu

usage() {
	echo "usage: osreboot-client heartbeat | stage NAME [PERCENT|-] [TEXT]" >&2
	exit 2
}

# POSTs the JSON $2 to /api/$1. curl reads the token from stdin (--config -),
# so it never shows up in the process list.
post() {
	printf 'header = "Authorization: Bearer %s"\n' "$token" |
		curl --silent --show-error --fail --max-time 5 --config - \
			--header 'Content-Type: application/json' \
			--data "$2" "$OSREBOOT_URL/api/$1" >/dev/null
}

# Prints $1 as a JSON string: drops control characters, escapes \ and ".
json_string() {
	text=$(printf '%s' "$1" | tr -d '\000-\037')
	text=$(printf '%s' "$text" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf '"%s"' "$text"
}

heartbeat() {
	# A new boot_id at every boot tells the server that the machine restarted.
	boot=$(cat /proc/sys/kernel/random/boot_id)
	while true; do
		post heartbeat "{\"boot\":\"$boot\"}" || true
		sleep 1
	done
}

stage() {
	[ $# -ge 1 ] || usage
	percent=null
	if [ -n "${2:-}" ] && [ "$2" != - ]; then
		echo "$2" | grep -qE '^[0-9]+(\.[0-9]+)?$' || usage
		percent=$2
	fi
	message=null
	if [ $# -ge 3 ]; then
		message=$(json_string "$3")
	fi
	body="{\"stage\":$(json_string "$1"),\"percent\":$percent,\"message\":$message}"
	for _ in 1 2 3; do
		post progress "$body" && return 0
		sleep 2
	done
	return 1
}

[ $# -ge 1 ] || usage
command=$1
shift

if [ -z "${OSREBOOT_URL:-}" ]; then
	echo "osreboot-client: OSREBOOT_URL is not set" >&2
	exit 1
fi
if [ -z "${OSREBOOT_TOKEN_FILE:-}" ]; then
	if [ -z "${CREDENTIALS_DIRECTORY:-}" ]; then
		echo "osreboot-client: set OSREBOOT_TOKEN_FILE or pass the osreboot-token credential" >&2
		exit 1
	fi
	OSREBOOT_TOKEN_FILE=$CREDENTIALS_DIRECTORY/osreboot-token
fi
token=$(cat "$OSREBOOT_TOKEN_FILE")

if [ "$command" = heartbeat ]; then
	heartbeat
elif [ "$command" = stage ]; then
	stage "$@"
else
	usage
fi
