# The token is encrypted with the machine's TPM, so the image carries no secrets.
[Unit]
Description=OSreboot heartbeat
Wants=network-online.target
After=network-online.target

[Service]
Environment=OSREBOOT_URL=https://example.org/osreboot
LoadCredentialEncrypted=osreboot-token
ExecStart=/usr/local/bin/osreboot-client heartbeat
Restart=always
RestartSec=2
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
