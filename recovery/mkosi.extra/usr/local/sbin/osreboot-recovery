#!/usr/bin/env bash
# Restores the test system from the OSreboot server. It runs in the recovery
# environment, from memory, and writes only the two partitions labelled
# osreboot-esp and osreboot-root:
#   1. finds and checks the partitions;
#   2. downloads the compressed images and SHA256SUMS into memory and checks them;
#   3. writes the images, reads them back, grows the root file system;
#   4. sets BootNext to the test system, saves its log there, reboots.
# Every step is reported to the server as a stage, but the restore does not
# depend on the reports. On an error it stops writing, shows the error on the
# console and leaves the root login on tty1 and SSH for a look around; after
# FALLBACK_MIN minutes the machine restarts into its own system, so that a
# machine nobody can walk up to does not stay here.
set -Eeuo pipefail

ESP_LABEL=osreboot-esp
ROOT_LABEL=osreboot-root
ESP_IMAGE=osreboot-test.esp.raw
ROOT_IMAGE=osreboot-test.root-x86-64.raw
ESP_TYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
# Linux data and x86-64 root: the types the root partition may have.
ROOT_TYPES="0fc63daf-8483-4772-8e79-3d69d8477de4 4f68bce3-e8cd-4db1-96e7-fbcaf984b709"
# Guards against writing a wrong partition: the test partitions are small,
# the main system's partition is not.
ESP_MAX=$((4 << 30))
ROOT_MAX=$((128 << 30))
ENTRY_LABEL="OSreboot test"
FALLBACK_MIN=20
LOADER='\EFI\systemd\systemd-bootx64.efi'
WORK=/run/osreboot
LOG_DIR=/var/log/osreboot

: "${OSREBOOT_URL:?OSREBOOT_URL is not set}"
FILES=${OSREBOOT_URL%/}/files
started=$SECONDS
in_memory=no

say() {
	printf '\n== %s\n' "$*"
}

# Reports to the server; a failed report only prints a note.
report() {
	[ -n "${OSREBOOT_TOKEN_FILE:-}" ] || return 0
	osreboot-client stage "$@" >/dev/null 2>&1 || echo "   (the server did not take the $1 report)"
}

fail() {
	trap - ERR
	echo
	echo "!! RECOVERY STOPPED: $*"
	report failed - "$*"
	echo "!! Nothing more is written. Log in on tty1 or over SSH to look around."
	[ "$in_memory" = yes ] || exit 1
	# BootNext and the one-shot entry are used up: the restart boots the
	# first entry of BootOrder, the machine's own system.
	if systemd-run --quiet --unit=osreboot-fallback-reboot --on-active="${FALLBACK_MIN}min" systemctl reboot; then
		echo "!! The machine restarts into its own system in $FALLBACK_MIN min; to stay, run"
		echo "!!   systemctl stop osreboot-fallback-reboot.timer"
	else
		echo "!! Could not schedule the restart."
	fi
	exit 1
}
# Errors inside $(...) and background jobs surface in the main shell.
trap '[ "$BASH_SUBSHELL" -gt 0 ] || fail "command failed at line $LINENO: $BASH_COMMAND"' ERR

# A transfer slower than 1 KiB/s for a minute counts as failed and is retried:
# without a limit a stalled connection would hang the recovery for good.
fetch() {
	curl --fail --silent --show-error --location --connect-timeout 10 \
		--speed-limit 1024 --speed-time 60 \
		--retry 5 --retry-all-errors --retry-delay 2 "$@"
}

# Sets the variable $1 to the only partition labelled $2.
find_partition() {
	local found
	for _ in $(seq 30); do
		udevadm settle
		found=$(lsblk -rno PATH,PARTLABEL | awk -v l="$2" '$2 == l { print $1 }')
		[ -z "$found" ] || break
		sleep 1
	done
	[ -n "$found" ] || fail "no partition is labelled $2"
	[ "$(wc -l <<<"$found")" = 1 ] || fail "more than one partition is labelled $2: ${found//$'\n'/ }"
	printf -v "$1" '%s' "$found"
}

# Checks that $1 may be overwritten with $2 bytes: its type, the file system
# found on it ($3 is the one allowed besides none), its size.
check_partition() {
	local dev=$1 need=$2 fs=$3 max=$4 types=$5 type found size
	type=$(lsblk -dno PARTTYPE "$dev")
	[[ " $types " == *" $type "* ]] || fail "$dev has the partition type $type"
	found=$(blkid -o value -s TYPE "$dev" || true)
	[ -z "$found" ] || [ "$found" = "$fs" ] || fail "$dev holds $found, not $fs: refusing to overwrite it"
	size=$(blockdev --getsize64 "$dev")
	[ "$size" -le "$max" ] || fail "$dev is $((size >> 30)) GiB, larger than a test partition"
	[ "$need" -le "$size" ] || fail "the image ($need bytes) does not fit into $dev ($size bytes)"
	[ -z "$(findmnt -rno TARGET -S "$dev")" ] || fail "$dev is mounted"
}

mkdir -p "$WORK"
chmod 0700 "$WORK"

# The token is encrypted with the TPM of the machine; in a virtual machine it
# can be passed in as a credential instead.
if systemd-creds decrypt --name=osreboot-token /etc/credstore.encrypted/osreboot-token "$WORK/token" 2>/dev/null; then
	export OSREBOOT_TOKEN_FILE=$WORK/token
elif [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -f "$CREDENTIALS_DIRECTORY/osreboot-token" ]; then
	export OSREBOOT_TOKEN_FILE=$CREDENTIALS_DIRECTORY/osreboot-token
else
	echo "No device token: the progress is shown here only."
fi

say "OSreboot recovery, kernel $(uname -r), server $OSREBOOT_URL"
case $(findmnt -no FSTYPE /) in
rootfs | tmpfs | ramfs) in_memory=yes ;;
*) fail "/ is not in memory: this is not the recovery environment" ;;
esac
report recovery - "running from memory, kernel $(uname -r)"

say "Looking for the partitions $ESP_LABEL and $ROOT_LABEL"
report partition - "looking for $ESP_LABEL and $ROOT_LABEL"
esp='' root=''
find_partition esp $ESP_LABEL
find_partition root $ROOT_LABEL
disk=/dev/$(lsblk -no PKNAME "$esp")
[ "$disk" = "/dev/$(lsblk -no PKNAME "$root")" ] || fail "$esp and $root are on different disks"
echo "   $esp ($ESP_LABEL) and $root ($ROOT_LABEL) on $disk"

say "Downloading the images from $FILES"
fetch -o "$WORK/SHA256SUMS" "$FILES/SHA256SUMS"
declare -A zsize
total=0
for image in $ESP_IMAGE $ROOT_IMAGE; do
	zsize[$image]=$(fetch --head "$FILES/$image.zst" | tr -d '\r' |
		awk 'tolower($1) == "content-length:" { n = $2 } END { print n + 0 }')
	[ "${zsize[$image]}" -gt 0 ] || fail "the server reports no size for $image.zst"
	total=$((total + zsize[$image]))
done
done_bytes=0
for image in $ESP_IMAGE $ROOT_IMAGE; do
	fetch -o "$WORK/$image.zst" "$FILES/$image.zst" &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		got=$(stat -c %s "$WORK/$image.zst" 2>/dev/null || echo 0)
		percent=$(((done_bytes + got) * 100 / total))
		printf '   %s: %3d%% of %d MiB\n' "$image.zst" "$percent" $((total >> 20))
		report download "$percent" "$image.zst"
		sleep 2
	done
	wait "$pid" || fail "could not download $image.zst"
	[ "$(stat -c %s "$WORK/$image.zst")" = "${zsize[$image]}" ] || fail "$image.zst is incomplete"
	done_bytes=$((done_bytes + zsize[$image]))
done
report download 100 "$((total >> 20)) MiB in $((SECONDS - started)) s"

say "Checking the images against SHA256SUMS"
report verify - "SHA-256 of both images"
declare -A size sum
for image in $ESP_IMAGE $ROOT_IMAGE; do
	sum[$image]=$(awk -v f="$image" '$2 == f || $2 == "*" f { print $1 }' "$WORK/SHA256SUMS")
	[ -n "${sum[$image]}" ] || fail "SHA256SUMS has no line for $image"
	[ "$(zstd -dcq "$WORK/$image.zst" | sha256sum | cut -d' ' -f1)" = "${sum[$image]}" ] ||
		fail "$image.zst does not match SHA256SUMS"
	size[$image]=$(zstd -dcq "$WORK/$image.zst" | wc -c)
	echo "   $image: $((size[$image] >> 20)) MiB, checksum matches"
done

say "Checking that the partitions may be overwritten"
check_partition "$esp" "${size[$ESP_IMAGE]}" vfat $ESP_MAX "$ESP_TYPE"
check_partition "$root" "${size[$ROOT_IMAGE]}" ext4 $ROOT_MAX "$ROOT_TYPES"
echo "   both checks passed"

# Writes image $1 into partition $2 and reads it back.
write_image() {
	local image=$1 dev=$2 pid written
	zstd -dcq "$WORK/$image.zst" | dd of="$dev" bs=4M iflag=fullblock oflag=direct status=none &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		written=$(awk '$1 == "wchar:" { print $2 }' "/proc/$pid/io" 2>/dev/null || echo 0)
		percent=$((${written:-0} * 100 / size[$image]))
		printf '   %s -> %s: %3d%%\n' "$image" "$dev" "$percent"
		report write "$percent" "$image -> $dev"
		sleep 2
	done
	wait "$pid" || fail "writing $image to $dev failed"
	blockdev --flushbufs "$dev"
	[ "$(head -c "${size[$image]}" "$dev" | sha256sum | cut -d' ' -f1)" = "${sum[$image]}" ] ||
		fail "the read-back of $dev does not match $image"
	echo "   $dev read back and verified"
	report write 100 "$image -> $dev, read back"
}

say "Writing the images"
write_image $ESP_IMAGE "$esp"
write_image $ROOT_IMAGE "$root"
rm -f "$WORK"/*.zst

say "Growing the root file system"
rc=0
e2fsck -f -y "$root" || rc=$?
[ "$rc" -le 1 ] || fail "e2fsck found errors it could not fix (code $rc)"
resize2fs "$root"

say "Setting the next boot to the test system"
report bootloader - "BootNext to the test system"
esp_uuid=$(lsblk -dno PARTUUID "$esp")
entry_for_esp() {
	efibootmgr -v | awk -v u="$esp_uuid" '/^Boot[0-9A-Fa-f]{4}/ && index(tolower($0), tolower(u)) { print substr($1, 5, 4); exit }'
}
entry=$(entry_for_esp)
if [ -z "$entry" ]; then
	efibootmgr --create-only --disk "$disk" --part "$(cat "/sys/class/block/${esp#/dev/}/partition")" \
		--label "$ENTRY_LABEL" --loader "$LOADER" >/dev/null
	entry=$(entry_for_esp)
	[ -n "$entry" ] || fail "could not create a boot entry for $esp"
fi
efibootmgr --bootnext "$entry" >/dev/null
echo "   BootNext is Boot$entry"

# This environment lives in memory: keep its log in the restored system.
say "Saving the log to $LOG_DIR on $root"
mkdir -p "$WORK/root"
if mount "$root" "$WORK/root"; then
	mkdir -p "$WORK/root$LOG_DIR"
	journalctl -b -u osreboot-recovery -o short-monotonic --no-pager >"$WORK/root$LOG_DIR/recovery.log" || true
	journalctl -b -o short-monotonic --no-pager >"$WORK/root$LOG_DIR/journal.log" || true
	umount "$WORK/root"
else
	echo "   could not mount $root, the log is lost"
fi

say "Restored in $((SECONDS - started)) s. Booting the test system."
report reboot - "restored in $((SECONDS - started)) s"
sleep 3
systemctl reboot
