# Restores the test system as soon as the recovery environment has a network.
# The progress goes to the console; the login prompt on tty1 appears only
# after the recovery has stopped.
[Unit]
Description=OSreboot recovery of the test system
Wants=network-online.target
# Only an order: Wants= would wait 90 s for a TPM device where there is none.
After=network-online.target tpm2.target
Before=getty@tty1.service

[Service]
Type=oneshot
Environment=OSREBOOT_URL=https://example.org/osreboot
# For a test in a virtual machine without the TPM: pass the token in.
ImportCredential=osreboot-token
ExecStart=/usr/local/sbin/osreboot-recovery
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
