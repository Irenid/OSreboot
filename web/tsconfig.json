{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../dist/web",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
